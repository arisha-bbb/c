<Window x:Class="Project2.views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Project2.views"
        mc:Ignorable="d"
        Title="Авторизация" 
        Height="600" 
        Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TextBox" x:Key="LoginTextBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,5,0,15"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>

        <Style TargetType="PasswordBox" x:Key="LoginPasswordBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,5,0,15"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        
        <Border Grid.Row="0" Background="#2C3E50" Padding="20">
            <TextBlock Text="Вход в систему АРМ Медицинская клиника"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"/>
        </Border>

        
        <StackPanel Grid.Row="1" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center"
                    Width="300">

            <TextBlock Text="👤" 
                       FontSize="48" 
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <TextBlock Text="Логин" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtLogin" 
                     Style="{StaticResource LoginTextBox}"
                     Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="Пароль" FontWeight="Bold" Margin="0,0,0,5"/>
            <PasswordBox x:Name="txtPassword" 
                         Style="{StaticResource LoginPasswordBox}"/>

            <TextBlock x:Name="txtError" 
                       Text="{Binding ErrorMessage}"
                       Foreground="Red" 
                       TextWrapping="Wrap"
                       Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button Content="Вход" 
                        x:Name="btnLogin"
                        Click="Button_Click"
                        Command="{Binding LoginCommand}"
                        Background="#27AE60" 
                        Foreground="White"
                        Width="100" 
                        Height="35"
                        Margin="0,0,10,0"/>

                <Button Content="Отмена" 
                        Command="{Binding CancelCommand}"
                        Background="#E74C3C" 
                        Foreground="White"
                        Width="100" 
                        Height="35"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>