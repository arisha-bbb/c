<Window x:Class="Project2.views.DoctorScheduleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Расписание врача" Height="400" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style TargetType="TextBox" x:Key="FormTextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Margin" Value="0,2,0,10"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#3498DB"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="White">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                       Text="Расписание врача"
                       FontSize="18" FontWeight="Bold"
                       Foreground="#2C3E50" Margin="0,0,0,15"/>

            <Rectangle Grid.Row="1" Grid.ColumnSpan="2" Height="1" Fill="#ECF0F1" Margin="0,0,0,15"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Врач *"
                       FontWeight="SemiBold" Foreground="#2C3E50" VerticalAlignment="Center"/>
            <ComboBox x:Name="cbDoctor" Grid.Row="2" Grid.Column="1"
                      DisplayMemberPath="FullName"
                      Height="32" Margin="0,2,0,10"/>
            
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Дата *"
                       FontWeight="SemiBold" Foreground="#2C3E50" VerticalAlignment="Center"/>
            <DatePicker x:Name="dpDate" Grid.Row="3" Grid.Column="1"
                        Height="32" Margin="0,2,0,10"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Время начала *"
                       FontWeight="SemiBold" Foreground="#2C3E50" VerticalAlignment="Center"/>
            <TextBox x:Name="txtSlotStart" Grid.Row="4" Grid.Column="1"
                     Style="{StaticResource FormTextBox}"
                     ToolTip="Формат: HH:MM"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Статус"
                       FontWeight="SemiBold" Foreground="#2C3E50" VerticalAlignment="Center"/>
            <ComboBox x:Name="cbStatus" Grid.Row="5" Grid.Column="1"
                      Height="32" Margin="0,2,0,10">
                <ComboBoxItem>Свободно</ComboBoxItem>
                <ComboBoxItem>Занято</ComboBoxItem>
                <ComboBoxItem>Отменено</ComboBoxItem>
            </ComboBox>

            <Grid Grid.Row="7" Grid.ColumnSpan="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Сохранить"
                        Click="BtnSave_Click"
                        Background="#27AE60" Foreground="White"
                        Height="38" Margin="0,0,10,0"
                        FontWeight="Bold" Cursor="Hand"/>

                <Button Grid.Column="1" Content="Отмена"
                        Click="BtnCancel_Click"
                        Background="#95A5A6" Foreground="White"
                        Height="38" Margin="10,0,0,0"
                        FontWeight="Bold" Cursor="Hand"/>
            </Grid>
        </Grid>
    </Border>
</Window>
