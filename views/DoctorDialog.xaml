<Window x:Class="Project2.views.DoctorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Добавить доктора" 
        Height="520" 
        Width="550"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style TargetType="TextBox" x:Key="FormTextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Margin" Value="0,2,0,10"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#3498DB"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox" x:Key="FormComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,2,0,10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Border Background="White">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" 
                       Text="Добавить доктора" 
                       FontSize="20" FontWeight="Bold"
                       Foreground="#2C3E50"
                       Margin="0,0,0,15"/>
            <Rectangle Grid.Row="1" Grid.ColumnSpan="2" 
                       Height="1" Fill="#ECF0F1" Margin="0,0,0,15"/>


            <TextBlock Grid.Row="2" Grid.Column="0" Text="Фамилия *"
                       FontWeight="SemiBold" Foreground="#2C3E50" VerticalAlignment="Center"/>
            <TextBox x:Name="txtSurname" Grid.Row="2" Grid.Column="1"
                     Style="{StaticResource FormTextBox}"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Имя *"
                       FontWeight="SemiBold" Foreground="#2C3E50" VerticalAlignment="Center"/>
            <TextBox x:Name="txtName" Grid.Row="3" Grid.Column="1"
                     Style="{StaticResource FormTextBox}"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Отчество"
                       FontWeight="SemiBold" Foreground="#2C3E50" VerticalAlignment="Center"/>
            <TextBox x:Name="txtPatronymic" Grid.Row="4" Grid.Column="1"
                     Style="{StaticResource FormTextBox}"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Специализация *"
                       FontWeight="SemiBold" Foreground="#2C3E50" VerticalAlignment="Center"/>
            <ComboBox x:Name="cbSpecialization" Grid.Row="5" Grid.Column="1"
                      Style="{StaticResource FormComboBox}">
                <ComboBoxItem>Терапевт</ComboBoxItem>
                <ComboBoxItem>Хирург</ComboBoxItem>
                <ComboBoxItem>Кардиолог</ComboBoxItem>
                <ComboBoxItem>Невролог</ComboBoxItem>
                <ComboBoxItem>Офтальмолог</ComboBoxItem>
                <ComboBoxItem>Отоларинголог (ЛОР)</ComboBoxItem>
                <ComboBoxItem>Дерматолог</ComboBoxItem>
                <ComboBoxItem>Гинеколог</ComboBoxItem>
                <ComboBoxItem>Уролог</ComboBoxItem>
                <ComboBoxItem>Ортопед</ComboBoxItem>
                <ComboBoxItem>Эндокринолог</ComboBoxItem>
                <ComboBoxItem>Психиатр</ComboBoxItem>
                <ComboBoxItem>Онколог</ComboBoxItem>
                <ComboBoxItem>Педиатр</ComboBoxItem>
                <ComboBoxItem>Стоматолог</ComboBoxItem>
            </ComboBox>

            <TextBlock Grid.Row="6" Grid.Column="0" Text="Кабинет"
                       FontWeight="SemiBold" Foreground="#2C3E50" VerticalAlignment="Center"/>
            <TextBox x:Name="txtOffice" Grid.Row="6" Grid.Column="1"
                     Style="{StaticResource FormTextBox}"/>


            <TextBlock Grid.Row="7" Grid.Column="0" Text="Телефон *"
                       FontWeight="SemiBold" Foreground="#2C3E50" VerticalAlignment="Center"/>
            <TextBox x:Name="txtPhone" Grid.Row="7" Grid.Column="1"
                     Style="{StaticResource FormTextBox}"/>


            <ItemsControl Grid.Row="9" Grid.ColumnSpan="2"
                          ItemsSource="{Binding ValidationErrors}"
                          Margin="0,5,0,5">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="#E74C3C" FontSize="11" Margin="0,1"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>


            <Grid Grid.Row="11" Grid.ColumnSpan="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Сохранить"
                        Click="BtnSave_Click"
                        Background="#27AE60" Foreground="White"
                        Height="38" Margin="0,0,10,0"
                        FontWeight="Bold" Cursor="Hand"/>

                <Button Grid.Column="1" Content="Отмена"
                        Click="BtnCancel_Click"
                        Background="#95A5A6" Foreground="White"
                        Height="38" Margin="10,0,0,0"
                        FontWeight="Bold" Cursor="Hand"/>
            </Grid>
        </Grid>
    </Border>
</Window>
