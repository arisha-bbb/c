<Page x:Class="Project2.pages.MedicalRecordPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MedicalRecord">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
               Text="Медицинские карты" 
               FontSize="20" 
               FontWeight="Bold"
               HorizontalAlignment="Center"
               Margin="0,0,0,15"/>


        <Border Grid.Row="1" 
                Background="#F0F0F0" 
                Padding="15" 
                CornerRadius="8"
                Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <TextBlock Grid.Column="0" Text="Пациент:" 
                           VerticalAlignment="Center" Margin="5"/>
                <ComboBox x:Name="cbPatient" 
                          Grid.Column="1"
                          DisplayMemberPath="FullName"
                          Height="30"
                          Margin="5"
                          SelectionChanged="CbPatient_SelectionChanged"/>

                <StackPanel Grid.Row="1" Grid.ColumnSpan="3" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Center" 
                            Margin="0,15,0,0">

                    <Button x:Name="btnAdd" 
                            Content="➕ Добавить"
                            Click="BtnAdd_Click"
                            Background="#27AE60" 
                            Foreground="White"
                            Width="110" Height="35" 
                            Margin="5"
                            Cursor="Hand"/>
                    
                    <Button x:Name="btnUpdate" 
                             Content="✏️ Изменить" 
                             Click="BtnUpdate_Click"                           
                             Background="#3498DB" 
                             Foreground="White"
                             Width="110" Height="35" 
                             Margin="5"
                             Cursor="Hand"/>

                    <Button x:Name="btnDelete" 
                            Content="🗑️ Удалить" 
                            Click="BtnDelete_Click"
                            Background="#E74C3C" 
                            Foreground="White"
                            Width="110" Height="35" 
                            Margin="5"
                            Cursor="Hand"/>

                    <Button x:Name="btnRefresh" 
                            Content="🔄 Обновить" 
                            Click="BtnRefresh_Click"
                            Background="#95A5A6" 
                            Foreground="White"
                            Width="110" Height="35" 
                            Margin="5"
                            Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <DataGrid x:Name="dgMedicalRecords" 
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionChanged="DgMedicalRecords_SelectionChanged"
                  Margin="0,10,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Record_ID}" Width="50"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding Record_Date}" Width="100"/>
                <DataGridTextColumn Header="Диагноз" Binding="{Binding Diagnosis}" Width="200"/>
                <DataGridTextColumn Header="Назначение" Binding="{Binding Treatment}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Background="#245358" Padding="10" CornerRadius="5">
            <TextBlock x:Name="txtStatus" 
                       Text="✅ Готов к работе" 
                       Foreground="White" 
                       FontSize="12"/>
        </Border>
    </Grid>
</Page>
