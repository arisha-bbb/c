<Page x:Class="Project2.pages.DoctorSchedulePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Project2.pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="DoctorSchedule">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
           Text="Расписание врачей" 
           FontSize="20" 
           FontWeight="Bold"
           HorizontalAlignment="Center"
           Margin="0,0,0,15"/>


        <Border Grid.Row="1" 
            Background="#F0F0F0" 
            Padding="15" 
            CornerRadius="8"
            Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.ColumnSpan="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center">

                   <TextBlock Text="Доктор:" VerticalAlignment="Center" Margin="5"/>
                   <ComboBox x:Name="cbDoctor" 
                      Width="250"
                      MinWidth="200"
                      MaxWidth="350"
                      DisplayMemberPath="FullName"
                      Height="30"
                      Margin="5"
                      HorizontalAlignment="Left"
                      SelectionChanged="CbDoctor_SelectionChanged"/>

                    <TextBlock Text="От:" VerticalAlignment="Center" Margin="5"/>
                    <DatePicker x:Name="dpStart" Width="130" Height="30" Margin="5"/>
                    <TextBlock Text="До:" VerticalAlignment="Center" Margin="5"/>
                    <DatePicker x:Name="dpEnd" Width="130" Height="30" Margin="5"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.ColumnSpan="3" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Center" 
                        Margin="0,15,0,0">

                    <Button x:Name="btnAdd" 
                        Content="➕ Добавить"
                        Click="BtnAdd_Click"
                        Background="#27AE60" 
                        Foreground="White"
                        Width="110" Height="35" 
                        Margin="5"
                        Cursor="Hand"/>

                    <Button x:Name="btnUpdate" 
                         Content="✏️ Изменить" 
                         Click="BtnUpdate_Click"                           
                         Background="#3498DB" 
                         Foreground="White"
                         Width="110" Height="35" 
                         Margin="5"
                         Cursor="Hand"/>

                    <Button x:Name="btnDelete" 
                        Content="🗑️ Удалить" 
                        Click="BtnDelete_Click"
                        Background="#E74C3C" 
                        Foreground="White"
                        Width="110" Height="35" 
                        Margin="5"
                        Cursor="Hand"/>

                    <Button x:Name="btnRefresh" 
                        Content="🔄 Обновить" 
                        Click="BtnRefresh_Click"
                        Background="#95A5A6" 
                        Foreground="White"
                        Width="110" Height="35" 
                        Margin="5"
                        Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <DataGrid x:Name="dgDoctorSchedule" 
              Grid.Row="2"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              SelectionChanged="DgDoctorSchedule_SelectionChanged"
              Margin="0,10,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Schedule_ID}" Width="50"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding WorkDate}" Width="100"/>
                <DataGridTextColumn Header="Время начала приема" Binding="{Binding SlotStart}" Width="200"/>
                <DataGridTextColumn Header="Конец приема" Binding="{Binding SlotEnd}" Width="200"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Background="#245358" Padding="10" CornerRadius="5">
            <TextBlock x:Name="txtStatus" 
                   Text="✅ Готов к работе" 
                   Foreground="White" 
                   FontSize="12"/>
        </Border>
    </Grid>
</Page>
