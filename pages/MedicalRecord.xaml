<Page x:Class="Project2.pages.MedicalRecord"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Project2.pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MedicalRecord">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <TextBlock Grid.Row="0" 
               Text="Медицинская карта" 
               FontSize="20" 
               FontWeight="Bold"
               Foreground="#2C3E50"
               Margin="0,0,0,15"/>

        <Rectangle Grid.Row="1" Height="1" Fill="#ECF0F1" Margin="0,0,0,15"/>

        <Border Grid.Row="2" Background="#F8F9FA" Padding="15" CornerRadius="5" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Пациент:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Grid.Column="1" Text="{Binding Patient.FullName}" VerticalAlignment="Center" Margin="0,0,15,0"/>

                <TextBlock Grid.Column="2" Text="Дата рождения:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Grid.Column="3" Text="{Binding Patient.DateBirth, StringFormat=dd.MM.yyyy}" VerticalAlignment="Center" Margin="0,0,15,0"/>

                <TextBlock Grid.Column="4" Text="Телефон:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Grid.Column="5" Text="{Binding Patient.Phone}" VerticalAlignment="Center"/>

                <TextBlock Grid.Row="1" Text="Адрес:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,5,10,0"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="5" Text="{Binding Patient.Address}" VerticalAlignment="Center" Margin="0,5,0,0"/>
            </Grid>
        </Border>


        <Border Grid.Row="3" Background="#F8F9FA" Padding="15" CornerRadius="5" Margin="0,0,0,15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" 
                       Text="Дата *" 
                       FontWeight="SemiBold" 
                       Foreground="#2C3E50"
                       VerticalAlignment="Center"/>
                <DatePicker Grid.Row="0" Grid.Column="1" 
                        SelectedDate="{Binding NewRecord.RecordDate}"
                        Width="150"
                        HorizontalAlignment="Left"/>

                <TextBlock Grid.Row="0" Grid.Column="2" 
                       Text="Диагноз *" 
                       FontWeight="SemiBold" 
                       Foreground="#2C3E50"
                       VerticalAlignment="Center"
                       Margin="10,0,10,0"/>
                <TextBox Grid.Row="0" Grid.Column="3" 
                     Text="{Binding NewRecord.Diagnosis, UpdateSourceTrigger=PropertyChanged}"
                     />

                <TextBlock Grid.Row="1" Grid.Column="0" 
                       Text="Назначение *" 
                       FontWeight="SemiBold" 
                       Foreground="#2C3E50"
                       VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" 
                     Text="{Binding NewRecord.Treatment, UpdateSourceTrigger=PropertyChanged}"
                     Height="60"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     Margin="0,2,0,10"/>

                <Button Grid.Row="2" Grid.Column="3" 
                    Content="Добавить запись" 

                    Background="#27AE60" 
                    Foreground="White"
                    Height="35"
                    Width="120"
                    HorizontalAlignment="Right"
                    FontWeight="SemiBold"
                    Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>


                <ItemsControl Grid.Row="3" Grid.ColumnSpan="4" 
                          ItemsSource="{Binding NewRecordErrors}"
                          Margin="0,5,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" 
                                   Foreground="#E74C3C" 
                                   FontSize="11"
                                   Margin="0,1,0,1"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>


        <Border Grid.Row="4" Background="#F8F9FA" Padding="15" CornerRadius="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="📋 История болезней" 
                       FontWeight="Bold" 
                       Margin="0,0,0,10"
                       FontSize="14"/>

                <DataGrid Grid.Row="1" 
                      ItemsSource="{Binding MedicalRecords}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectedItem="{Binding SelectedRecord}"
                      IsReadOnly="True">

                    <DataGrid.Columns>

                        <DataGridTemplateColumn Header=" " Width="45">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="✏️" 
                                        Command="{Binding DataContext.EditRecordCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        FontSize="14"
                                        ToolTip="Редактировать"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>


                        <DataGridTemplateColumn Header=" " Width="45">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="🗑️" 
                                        Command="{Binding DataContext.DeleteRecordCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        FontSize="14"
                                        ToolTip="Удалить"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>


                        <DataGridTextColumn Header="Дата" 
                                        Binding="{Binding RecordDate, StringFormat=dd.MM.yyyy}" 
                                        Width="100"/>


                        <DataGridTextColumn Header="Диагноз" 
                                        Binding="{Binding Diagnosis}" 
                                        Width="200"/>


                        <DataGridTextColumn Header="Назначение" 
                                        Binding="{Binding Treatment}" 
                                        Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>


        <Grid Grid.Row="5" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" 
                   Text="{Binding StatusMessage}" 
                   Foreground="{Binding StatusColor}"
                   VerticalAlignment="Center"
                   FontSize="12"/>

            <Button Grid.Column="1" 
                Content="Закрыть" 

                Background="#95A5A6" 
                Foreground="White"
                Width="100"
                Height="35"
                Margin="10,0,0,0"
                FontWeight="Bold"
                Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Grid>
</Page>
