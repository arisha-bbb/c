<Page x:Class="Project2.pages.ReportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ReportPage">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Отчеты"
                   FontSize="20" FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,15"/>
        
        <Border Grid.Row="1" Background="#F0F0F0" Padding="15" CornerRadius="8" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="От:" VerticalAlignment="Center" Margin="5"/>
                <DatePicker x:Name="dpStart" Width="130" Height="30" Margin="5"/>
                <TextBlock Text="До:" VerticalAlignment="Center" Margin="5"/>
                <DatePicker x:Name="dpEnd" Width="130" Height="30" Margin="5"/>
                <Button Content="🔄 Обновить"
                        Click="BtnRefresh_Click"
                        Background="#3498DB" Foreground="White"
                        Width="110" Height="35" Margin="5" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <TabControl x:Name="tabReports"  Grid.Row="2">
        
            <TabItem Header="🙍 Пациенты">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Список пациентов" FontWeight="Bold" Margin="0,0,0,10"/>
                    <DataGrid x:Name="dgPatients" Grid.Row="1"
                              AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}"  Width="*"/>
                            <DataGridTextColumn Header="Дата рождения" Binding="{Binding Date_birth, StringFormat=dd.MM.yyyy}" Width="130"/>
                            <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="📑 Приёмы">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Записи на приём" FontWeight="Bold" Margin="0,0,0,10"/>
                    <DataGrid x:Name="dgAppointments" Grid.Row="1"
                              AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Пациент" Binding="{Binding PatientFullName}" Width="*"/>
                            <DataGridTextColumn Header="Доктор" Binding="{Binding DoctorFullName}" Width="*"/>
                            <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="100"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="📋 Диагнозы">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Медицинские карты" FontWeight="Bold" Margin="0,0,0,10"/>
                    <DataGrid x:Name="dgMedical" Grid.Row="1"
                              AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Пациент" Binding="{Binding PatientFullName}"  Width="*"/>
                            <DataGridTextColumn Header="Дата" Binding="{Binding Record_Date, StringFormat=dd.MM.yyyy}" Width="100"/>
                            <DataGridTextColumn Header="Диагноз" Binding="{Binding Diagnosis}" Width="200"/>
                            <DataGridTextColumn Header="Назначение" Binding="{Binding Treatment}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3" Background="#ECF0F1" Padding="10" CornerRadius="5" Margin="0,5,0,5">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="📄 в Excel"
                        Click="BtnExcel_Click"
                        Background="#27AE60" Foreground="White"
                        Width="150" Height="35" Margin="5" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Background="#245358" Padding="10" CornerRadius="5">
            <TextBlock x:Name="txtStatus"
                       Text="✅ Готов к работе"
                       Foreground="White" FontSize="12"/>
        </Border>
    </Grid>
</Page>
