<Page x:Class="Project2.pages.PatientPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Project2.pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PatientPage">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <TextBlock Grid.Row="0" 
               Text="Управление пациентами" 
               FontSize="20" 
               FontWeight="Bold"
               HorizontalAlignment="Center"
               Margin="0,0,0,15"/>


        <Border Grid.Row="1" 
            Background="#F0F0F0" 
            Padding="15" 
            CornerRadius="8"
            Margin="0,0,0,15">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <TextBlock Text="ФИО" VerticalAlignment="Center" Margin="5"/>
                <TextBox x:Name="txtName" Grid.Column="1" Margin="5" Height="30"/>

                <TextBlock Text="Дата рождения" Grid.Column="2" VerticalAlignment="Center" Margin="5"/>
                <TextBox x:Name="txtDate" Grid.Column="3" Margin="5" Height="30"/>

                <TextBlock Text="Номер паспорта" Grid.Column="4" VerticalAlignment="Center" Margin="5"/>
                <TextBox x:Name="txtInsurance" Grid.Column="5" Margin="5" Height="30"/>


                <StackPanel Grid.Row="1" Grid.ColumnSpan="6" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Center" 
                        Margin="0,15,0,0">

                    <Button x:Name="btnAdd" 
                        Content="➕ Добавить"
                        Click="BtnAdd_Click"
                        Background="#27AE60" 
                        Foreground="White"
                        Width="110" Height="35" 
                        Margin="5"
                        Cursor="Hand"/>

                    <Button x:Name="btnUpdate" 
                        Content="✏️ Изменить" 
                        Click="BtnUpdate_Click"                           
                        Background="#3498DB" 
                        Foreground="White"
                        Width="110" Height="35" 
                        Margin="5"
                        Cursor="Hand"/>

                    <Button x:Name="btnDelete" 
                        Content="🗑️ Удалить" 
                        Click="BtnDelete_Click"
                        Background="#E74C3C" 
                        Foreground="White"
                        Width="110" Height="35" 
                        Margin="5"
                        Cursor="Hand"/>

                    <Button x:Name="btnRefresh" 
                        Content="🔄 Обновить" 
                        Click="BtnRefresh_Click"
                        Background="#95A5A6" 
                        Foreground="White"
                        Width="110" Height="35" 
                        Margin="5"
                        Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <DataGrid x:Name="dgPatients" 
              SelectionChanged="DgPatients_SelectionChanged"
              Grid.Row="2"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              Margin="0,10,0,10">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Patient_ID}" Width="50"/>
                <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*"/>
                <DataGridTextColumn Header="Дата рождения" Binding="{Binding Date_birth}" Width="100"/>
                <DataGridTextColumn Header="Пол" Binding="{Binding Gender}" Width="100"/>
                <DataGridTextColumn Header="Адрес" Binding="{Binding Address}" Width="100"/>
                <DataGridTextColumn Header="Номер телефона" Binding="{Binding Phone}" Width="100"/>
                <DataGridTextColumn Header="Номер паспорта" Binding="{Binding Insurance_Number}" Width="100"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Background="#245358" Padding="10" CornerRadius="5">
            <TextBlock x:Name="txtStatus" 
                   Text="✅ Готов к работе" 
                   Foreground="White" 
                   FontSize="12"/>
        </Border>
    </Grid>
</Page>
